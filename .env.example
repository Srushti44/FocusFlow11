# FocusFlow Environment Configuration

# Copy this file to .env and add a valid Gemini API key. Never commit .env.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# Backend Host & Port
HOST=127.0.0.1
PORT=8000

# Frontend Vite Port
VITE_PORT=5173
VITE_API_URL=http://localhost:8000/api
